{
  "state": ".notifier/state.json",
  "grace": "12h",
  "lock_timeout": 60,
  "targets": {
    "slack": {
      "type": "slack",
      "url": "${NOTIFIER_SLACK_URL}",
      "retries": 3,
      "backoff": 0.5,
      "timeout": 30
    },
    "hook": {
      "type": "webhook",
      "url": "${NOTIFIER_WEBHOOK_URL}"
    }
  },
  "skip": ["draft-note"],
  "items": [
    {
      "id": "draft-note",
      "due": "2026-12-01T12:00:00+00:00",
      "target": "slack",
      "message": "Draft {id} stays on the skip list."
    },
    {
      "id": "status-ping",
      "due": "2026-12-01T16:00:00+00:00",
      "target": "hook",
      "message": "Status {code} at {due}.",
      "values": {"code": 200}
    }
  ]
}
